{"nodes": [{"id": "openspec_changes_archive_2026_10_06_conways_game_of_life_design_architecture", "label": "Conway's Game of Life Design", "file_type": "document", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_mapset_sparse_grid", "label": "MapSet Sparse Grid Representation", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MapSet of {x,y} tuples chosen over 2D list/array (sparse, memory proportional to alive cells), Map (simpler, no per-cell data), and ETS (overkill for single-process). O(1) membership testing."}, {"id": "concept_ratatouille_tui", "label": "Ratatouille TUI Framework", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ratatouille chosen over raw ANSI escape codes (provides Elm-architecture loop, event handling, layout primitives) and direct ExTermbox (higher-level API with no loss). Tick driven by Process.send_after/3."}, {"id": "concept_module_structure", "label": "Module Structure (Engine, RLE, Patterns, UI.App)", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Four modules: Engine (stateless pure functions), RLE (parser), Patterns (bundled .rle files from priv/patterns/), UI.App (Ratatouille app with state). Minimal coupling between simulation, parsing, and presentation."}, {"id": "concept_self_messaging_tick", "label": "Simulation Tick via Self-Messaging", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D4", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Process.send_after/3 chosen over separate GenServer (unnecessary complexity) and :timer.send_interval (harder to adjust dynamically). Speed changes simply alter the interval."}, {"id": "concept_viewport_calculation", "label": "Viewport Centering Calculation", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D5", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Compute bounding box of alive cells on pattern load, center viewport. Render at (cell_x - viewport_left, cell_y - viewport_top), clip to bounds."}, {"id": "concept_bundled_rle_patterns", "label": "Bundled Patterns as .rle Files", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ship as actual .rle files in priv/patterns/ rather than hardcoded coordinates. Exercises the RLE parser on every load, adding new patterns is just dropping a file."}, {"id": "concept_escript_distribution", "label": "Mix Escript Distribution", "file_type": "rationale", "source_file": "openspec/changes/archive/2026-10-06-conways-game-of-life/design.md", "source_location": "D7", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Build as escript (mix escript.build) for single-binary distribution. Main entry point invokes Ratatouille.run/2."}], "edges": [{"source": "openspec_changes_archive_2026_10_06_conways_game_of_life_design_architecture", "target": "openspec_changes_archive_2026_10_06_conways_game_of_life_proposal_conways_game_of_life", "relation": "references", "confidence": "EX