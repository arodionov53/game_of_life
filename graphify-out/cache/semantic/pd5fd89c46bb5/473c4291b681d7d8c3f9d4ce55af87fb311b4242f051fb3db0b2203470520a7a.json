{"nodes": [{"id": "_claude_commands_opsx_propose_opsx_propose", "label": "OPSX: Propose Command", "file_type": "document", "source_file": ".claude/commands/opsx/propose.md", "source_location": null, "source_url": null, "captured_at": "2026-10-07", "author": "openspec", "contributor": null}, {"id": "openspec_change", "label": "OpenSpec Change", "file_type": "concept", "source_file": ".claude/commands/opsx/propose.md", "source_location": null, "source_url": null, "captured_at": "2026-10-07", "author": "openspec", "contributor": null, "rationale": "A change is a named unit of work in OpenSpec containing planning artifacts (proposal, specs, design, tasks) that progress through propose, apply, sync, update, and archive stages."}, {"id": "openspec_artifact", "label": "OpenSpec Artifact", "file_type": "concept", "source_file": ".claude/commands/opsx/propose.md", "source_location": null, "source_url": null, "captured_at": "2026-10-07", "author": "openspec", "contributor": null, "rationale": "Artifacts are the planning documents within a change (proposal.md, spec.md, design.md, tasks.md) managed via a dependency graph with status tracking (done, skipped, ready, blocked)."}, {"id": "spec_driven_schema", "label": "Spec-Driven Schema", "file_type": "concept", "source_file": ".claude/commands/opsx/propose.md", "source_location": null, "source_url": null, "captured_at": "2026-10-07", "author": "openspec", "contributor": null, "rationale": "The default workflow schema producing proposal, specs (delta), design, and tasks artifacts in dependency order. Custom schemas are also supported."}, {"id": "planning_boundary", "label": "Planning Boundary", "file_type": "rationale", "source_file": ".claude/commands/opsx/propose.md", "source_location": null, "source_url": null, "captured_at": "2026-10-07", "author": "openspec", "contributor": null, "rationale": "The propose workflow creates planning artifacts only and never edits project code, even if the triggering request asks to build. Imple